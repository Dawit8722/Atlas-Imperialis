                          className="p-2 bg-stone-900 rounded-lg border border-stone-800 flex items-center justify-between text-[11px]"
                        >
                          <div>
                            <div className="font-medium text-stone-200">
                              {route.isMaritime ? '⛵' : '🛣️'} To {otherName}
                            </div>
                            <div className="text-[10px] text-stone-400">
                              {route.type} · {route.distanceKm} km
