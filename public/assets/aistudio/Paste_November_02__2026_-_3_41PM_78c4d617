                      >
                        {lord.coatOfArms.symbol}
                      </div>
                      <div className="min-w-0 flex-1">
                        <div className="flex items-center justify-between">
                          <div className="text-xs font-serif font-bold text-amber-100 truncate">
                            {lord.name}
