                        <div className="flex items-center justify-between">
                          <span className="text-stone-200 flex items-center gap-1.5">
                            <span>{caravan.isMaritime ? '⛵' : '🐎'}</span>
                            <span>{caravan.fromBurgName} → {caravan.toBurgName}</span>
