                  <div className="text-sm font-bold text-stone-100 font-mono mt-0.5">
                    {burg.population.toLocaleString()} souls
                  </div>
                </div>
                <div className="p-2.5 bg-stone-900 rounded-lg border border-stone-800">
                  <div className="text-stone-400">Trade Export</div>
                  <div className="text-xs font-semibold text-amber-300 mt-0.5 truncate">
                    {burg.tradeGood}
                  </div>
                </div>
              </div>

              <div className="p-2.5 bg-stone-900 rounded-lg border border-stone-800 text-[11px] space-y-1">
                <div className="text-stone-400 text-[10px] uppercase font-bold tracking-wider">
                  Geographic Site Advantage
                </div>
                <div className="font-medium text-amber-300 flex items-center gap-1.5">
                  <span>
                    {burg.settlementSite === 'Estuary Harbor' ? '🌊' :
                     burg.settlementSite === 'River Confluence' ? '🏞️' :
                     burg.settlementSite === 'Mountain Pass' ? '⛰️' :
                     burg.settlementSite === 'Fertile Basin' ? '🌾' : '🛣️'}
