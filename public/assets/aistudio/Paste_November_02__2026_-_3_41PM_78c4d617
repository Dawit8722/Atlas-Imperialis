                      </div>
                      <span className={`text-[10px] font-mono px-2 py-0.5 rounded font-bold ${
                        isLoyal ? 'bg-emerald-950/80 text-emerald-300 border border-emerald-700/40' : 'bg-red-950/80 text-red-300 border border-red-700/40'
                      }`}>
                        {isLoyal ? `+${lordOpinionOfLiege} Loyal Vassal` : `${lordOpinionOfLiege} Discontented`}
                      </span>
                    </div>

                    <div className="flex items-start gap-3">
                      <div
                        className="w-11 h-11 rounded-lg flex items-center justify-center text-lg border border-amber-600/50 shadow-inner shrink-0"
