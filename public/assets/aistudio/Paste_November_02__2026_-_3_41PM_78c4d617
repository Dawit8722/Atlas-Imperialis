            </div>
            {vassals.map((member) => (
              <CharacterListItem
                key={member.id}
                char={member}
                isSelected={member.id === activeChar?.id}
                onSelect={() => {
                  setInspectedCharId(member.id);
                  onSelectCharacter(member);
                }}
              />
            ))}
          </div>
