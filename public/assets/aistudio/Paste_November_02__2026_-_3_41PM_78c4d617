                    : burg.settlementSite === 'River Confluence'
                    ? 'Strategic inland trade fork where major river branches merge, creating a natural meeting point for regional commerce.'
                    : burg.settlementSite === 'Mountain Pass'
                    ? 'Fortified alpine saddle controlling the single mountain pass through the high crags, extracting toll and providing defense.'
                    : burg.settlementSite === 'Fertile Basin'
                    ? 'Lush agricultural flood basin with rich topsoil and gentle slopes supporting dense peasant populations and grain harvests.'
                    : 'Historic overland crossroad where merchant roads converge from surrounding marches.'}
                </div>
              </div>

              {burgConnectedRoutes.length > 0 && (
                <div className="space-y-1.5 pt-1">
                  <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider">
                    Connected Trade Routes ({burgConnectedRoutes.length})
                  </div>
                  <div className="space-y-1.5">
                    {burgConnectedRoutes.map((route) => {
                      const otherName = route.fromBurgId === burg.id ? route.toBurgName : route.fromBurgName;
