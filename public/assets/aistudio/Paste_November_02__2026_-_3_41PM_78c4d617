                          <span className="text-[10px] text-stone-400 capitalize">{lord.gender}, {lord.age}y</span>
                        </div>
                        <div className="text-[11px] text-amber-400 font-medium">
                          {lord.title}
                        </div>
                        <div className="text-[10px] text-stone-400 italic truncate mt-0.5">
                          "{lord.houseMotto || 'Guardians of the Ancient Marches'}"
                        </div>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-2 pt-1 border-t border-stone-800/80 text-[10px]">
                      <div>
                        <div className="text-stone-500 uppercase tracking-wider text-[9px] mb-1 font-bold">Traits</div>
                        <div className="flex flex-wrap gap-1">
                          {lord.personalityTraits.slice(0, 3).map((trait) => (
                            <span key={trait} className="px-1.5 py-0.5 rounded bg-stone-950 text-stone-300 border border-stone-800 text-[9px]">
                              {trait}
                            </span>
                          ))}
                        </div>
                      </div>
                      <div>
                        <div className="text-stone-500 uppercase tracking-wider text-[9px] mb-1 font-bold">Attributes</div>
                        <div className="flex items-center gap-1.5 font-mono text-[9px] text-stone-300">
                          <span>MAR <strong className="text-red-400">{lord.baseMartial}</strong></span>
                          <span>DIP <strong className="text-blue-400">{lord.baseDiplomacy}</strong></span>
                          <span>STE <strong className="text-amber-400">{lord.baseStewardship}</strong></span>
                          <span>INT <strong className="text-purple-400">{lord.baseIntrigue}</strong></span>
                        </div>
                      </div>
                    </div>

                    {lord.activeScheme && (
                      <div className="p-2 bg-stone-950 border border-amber-900/40 rounded-lg text-[10px] space-y-0.5">
                        <div className="flex items-center justify-between font-semibold text-amber-300">
                          <span className="flex items-center gap-1">
                            <span>🗡️ Plot:</span>
                            <span>{lord.activeScheme.type}</span>
                          </span>
                          <span className="font-mono text-[9px] text-amber-400">{lord.activeScheme.progress}%</span>
                        </div>
                        <div className="text-stone-400 text-[9px] leading-tight">
                          {lord.activeScheme.motive}
                        </div>
                      </div>
                    )}

                    <div className="flex items-center gap-2 pt-1">
                      <button
                        onClick={() => {
                          setInspectedCharId(lord.id);
                          onSelectCharacter(lord);
                        }}
                        className="flex-1 py-1 px-2 rounded bg-stone-800 hover:bg-stone-700 text-stone-200 text-[10px] font-medium text-center transition-colors cursor-pointer"
                      >
                        Inspect Dossier →
                      </button>
                      {onWeaveStoryForCharacter && (
                        <button
                          onClick={() => onWeaveStoryForCharacter(lord)}
                          className="py-1 px-2 rounded bg-amber-900/60 hover:bg-amber-800/80 text-amber-200 text-[10px] font-medium transition-colors cursor-pointer"
                        >
                          Weave Saga 📜
                        </button>
                      )}
                    </div>
                  </div>
                );
              })()}

              {(() => {
                const prov = world.provinces?.find((p) => p.name === county.name || p.cellIndices?.some((idx) => county.cellIndices.includes(idx)));
                const holdings = world.holdings?.filter((h) => prov && h.provinceId === prov.id) || [];
                const isQuarantined = prov && world.lockedDownProvinces?.includes(prov.id);

                return (
                  <div className="space-y-2 pt-1">
                    <div className="p-2.5 bg-stone-900/90 border border-stone-800 rounded-lg space-y-2 text-[11px]">
                      <div className="flex items-center justify-between">
                        <span className="text-stone-400">Terrain Geography:</span>
                        <span className="font-bold text-amber-300 flex items-center gap-1">
                          <span>{prov?.terrain === 'Mountains' ? '🏔️ Mountains (+40% Def)' : prov?.terrain === 'Forest' ? '🌲 Forest (+20% Def)' : prov?.terrain === 'Coastal' ? '🌊 Coastal' : '🌾 Plains'}</span>
                        </span>
                      </div>
                      <div className="flex items-center justify-between">
                        <span className="text-stone-400">Sanitary Lockdown:</span>
                        <span className={`font-bold ${isQuarantined ? 'text-red-400' : 'text-emerald-400'}`}>
                          {isQuarantined ? '🔒 Quarantined' : 'Open Borders'}
                        </span>
                      </div>
                    </div>

                    {holdings.length > 0 && (
                      <div className="space-y-1 pt-1">
                        <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider">
                          County Holdings ({holdings.length})
                        </div>
                        <div className="space-y-1">
                          {holdings.map((h) => {
                            const owner = world.characters.find((c) => c.id === h.ownerId);
                            return (
                              <div
                                key={h.id}
                                className="p-2 bg-stone-900/60 border border-stone-800 rounded-lg flex items-center justify-between text-[11px]"
                              >
                                <div className="flex items-center gap-1.5">
                                  <span>{h.estateType === 'Castle' ? '🏰' : h.estateType === 'City' ? '🏙️' : '⛪'}</span>
                                  <div>
                                    <div className="font-semibold text-stone-200">{h.name}</div>
                                    <div className="text-[10px] text-stone-400">
                                      {h.estateType} · Ruler: {owner?.name || 'Unassigned'}
                                    </div>
                                  </div>
                                </div>
                                <div className="text-right text-[10px] font-mono">
                                  <div className="text-amber-400">{Math.round(h.baseTax * (h.dev / 10))}g Tax</div>
                                  <div className="text-stone-400">{Math.round(h.baseLevy * (h.dev / 10))} Levies</div>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })()}

              {(() => {
                const countyBurgs = world.burgs.filter((b) => b.countyId === county.id);
                if (countyBurgs.length === 0) return null;
                return (
                  <div className="space-y-1.5 pt-1 border-t border-stone-800/80">
                    <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider">
                      Constituent Settlements & Citadels ({countyBurgs.length})
                    </div>
                    <div className="space-y-1.5">
                      {countyBurgs.map((b) => (
                        <div
                          key={b.id}
                          onClick={() => {
                            onSelectBurg(b);
                            setActiveTab('citadel');
                          }}
                          className={`p-2 rounded-lg border flex items-center justify-between cursor-pointer transition-colors ${
                            b.id === burg?.id
                              ? 'bg-amber-950/70 border-amber-600 text-amber-200'
                              : 'bg-stone-900/80 border-stone-800 hover:border-amber-700/50 text-stone-300'
                          }`}
                        >
                          <div className="flex items-center gap-2">
                            <span>{b.isCapital ? '👑' : b.type.includes('Port') ? '⚓' : b.type.includes('Village') ? '🌾' : '🏰'}</span>
                            <div>
                              <div className="font-serif font-bold text-xs">{b.name}</div>
                              <div className="text-[10px] text-stone-400">{b.type} · Exports {b.tradeGood}</div>
                            </div>
                          </div>
                          <span className="font-mono text-[10px] text-stone-400 font-bold">
                            {b.population.toLocaleString()} souls
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })()}
            </div>
          </div>
        )}
      </div>

      {isEventModalOpen && activeChar && (
        <CK3EventModal
          isOpen={isEventModalOpen}
          onClose={() => setIsEventModalOpen(false)}
          character={activeChar}
          world={world}
          onApplyEventOutcome={handleApplyEventOutcome}
        />
      )}
    </motion.aside>
  );
};

interface CharacterDetailCardProps {
  char: Character;
  world: WorldState;
  spouse?: Character;
  heir?: Character;
  rival?: Character;
  lover?: Character;
  onSelectCharacter: (char: Character) => void;
  onTriggerEvent: () => void;
  onExecuteScheme: () => void;
  onWeaveStoryForCharacter?: (char: Character) => void;
  isMonarch: boolean;
}

const CharacterDetailCard: React.FC<CharacterDetailCardProps> = ({
  char,
  world,
  spouse,
  heir,
  rival,
  lover,
  onSelectCharacter,
  onTriggerEvent,
  onExecuteScheme,
  onWeaveStoryForCharacter,
  isMonarch,
}) => {
  const [showOpinions, setShowOpinions] = useState(false);
  const stats = computeCharacterStats(char);

  const opinionEntries = useMemo(() => {
    return Object.entries(char.opinions || {})
      .map(([targetId, score]) => {
        const other = world.characters.find((c) => c.id === targetId);
        return { targetId, name: other?.name || 'Unknown Noble', role: other?.role, score };
      })
      .filter((e) => Math.abs(e.score) >= 15)
      .sort((a, b) => b.score - a.score)
      .slice(0, 6);
  }, [char.opinions, world.characters]);

  const charProvince = world.provinces?.find((p) => p.id === char.provinceId);
  const destProvince = char.travelDestProvinceId
    ? world.provinces?.find((p) => p.id === char.travelDestProvinceId)
    : null;
  const totalGravitas = Math.round(
    computeTotalGravitas(
      char.organicGravitas || {
        militaryAutonomy: 120,
        economicExtraction: 50,
        populistLoyalty: 200,
        lineagePrestige: 50,
        sovereignDebtHeld: 0,
      }
    )
  );

  const terrainIcon =
    charProvince?.terrain === 'Mountains'
      ? '🏔️'
      : charProvince?.terrain === 'Forest'
      ? '🌲'
      : charProvince?.terrain === 'Coastal'
      ? '🌊'
      : '🌾';

  return (
    <div className="p-4 bg-stone-950/90 border border-stone-800 rounded-xl space-y-3.5 shadow-xl">
      <div className="flex items-start gap-3">
        <div
          className="w-13 h-13 rounded-xl border-2 border-amber-500/80 flex items-center justify-center text-2xl shadow-xl shrink-0"
          style={{ backgroundColor: char.coatOfArms.bg, color: char.coatOfArms.fg }}
        >
          {char.coatOfArms.symbol}
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-1.5">
            {isMonarch ? (
              <Crown className="w-3.5 h-3.5 text-amber-400 shrink-0" />
            ) : (
              <Shield className="w-3.5 h-3.5 text-stone-400 shrink-0" />
            )}
            <h3 className="font-serif font-bold text-sm text-stone-100 truncate">
              {char.name}
            </h3>
          </div>
          <div className="text-[11px] text-amber-400 font-medium truncate mt-0.5">
            {char.title}
          </div>
          <div className="flex items-center gap-1.5 text-[10px] text-stone-400 mt-0.5">
            <span>House {char.houseName}</span>
            <span className="text-stone-600">·</span>
            <span>Age {char.age}</span>
            <span className="text-stone-600">·</span>
            <span className="px-1.5 py-0.2 bg-amber-950/60 border border-amber-700/50 text-amber-300 rounded font-medium">
              {char.aiArchetype}
            </span>
          </div>
        </div>
      </div>

      <div className="p-2 bg-stone-900 border border-stone-800 rounded-lg text-stone-300 italic text-[11px] text-center font-serif">
        "{char.houseMotto}"
      </div>

      <div className="p-2.5 bg-stone-900/95 border border-amber-900/50 rounded-xl space-y-1.5 shadow-inner">
        <div className="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider">
          <span className="text-amber-400 flex items-center gap-1">
            <span>{terrainIcon}</span>
            <span>{charProvince?.name || 'Capital Province'}</span>
            <span className="text-stone-400 font-normal">({charProvince?.terrain || 'Plains'})</span>
          </span>
          <span className="text-stone-400 font-mono">
            {char.courtPosition?.orbit === 'INNER_RING'
              ? '👑 Inner Ring'
              : char.courtPosition?.orbit === 'MIDDLE_RING'
              ? '🛡️ Middle Ring'
              : '🏛️ Outer Ring'}
          </span>
        </div>

        {char.isTraveling && destProvince ? (
          <div className="p-1.5 bg-amber-950/70 border border-amber-700/60 rounded-lg text-[10px] text-amber-200 flex items-center justify-between animate-pulse">
            <span className="flex items-center gap-1">
              <span>🏇</span>
              <span>In transit to <strong>{destProvince.name}</strong> ({char.travelPurpose || 'Court Embassy'})</span>
            </span>
            <span className="font-mono font-bold">{char.travelMonthsLeft}mo left</span>
          </div>
        ) : (
          <div className="flex items-center justify-between text-[10px] text-stone-400">
            <span>Seat Defense: <strong className="text-amber-300">+{charProvince?.terrain === 'Mountains' ? '40%' : charProvince?.terrain === 'Forest' ? '20%' : '10%'}</strong></span>
            <span>Psyche: <strong className="text-stone-200">{char.psychState || 'Normal'}</strong></span>
          </div>
        )}

        <div className="grid grid-cols-2 gap-1 pt-0.5 text-[10px]">
          <div className="p-1 bg-stone-950/70 rounded border border-stone-800 flex items-center justify-between px-2">
            <span className="text-stone-400">⚔️ Men-at-Arms:</span>
            <span className="font-mono font-bold text-amber-300">{char.menAtArms || 100}</span>
          </div>
          <div className="p-1 bg-stone-950/70 rounded border border-stone-800 flex items-center justify-between px-2">
            <span className="text-stone-400">👑 Gravitas:</span>
            <span className="font-mono font-bold text-amber-300">{totalGravitas}</span>
          </div>
        </div>
      </div>

      <button
        onClick={onTriggerEvent}
        className="w-full py-2 bg-gradient-to-r from-amber-700 via-amber-600 to-amber-700 hover:from-amber-600 hover:to-amber-500 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer shadow-md border border-amber-500/60"
      >
        <Sparkles className="w-3.5 h-3.5" />
        <span>Trigger Court Dilemma / Decision</span>
      </button>

      <div>
        <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider mb-1.5 flex items-center justify-between">
          <span>Core Attributes</span>
          <span className="text-amber-400 font-mono text-[10px] font-bold">Prowess: {stats.prowess}</span>
        </div>
        <div className="grid grid-cols-5 gap-1.5 text-center">
          <div className="p-1.5 bg-stone-900 border border-stone-800 rounded-lg" title="Diplomacy: Treaties & Court Vassal Relations">
            <div className="text-[11px]">🕊️</div>
            <div className="text-[9px] text-stone-400 font-sans">DIP</div>
            <div className="text-xs font-bold text-stone-100 font-mono">{stats.diplomacy}</div>
          </div>
          <div className="p-1.5 bg-stone-900 border border-stone-800 rounded-lg" title="Martial: Battlefield Command & Levy Sizes">
            <div className="text-[11px]">⚔️</div>
            <div className="text-[9px] text-stone-400 font-sans">MAR</div>
            <div className="text-xs font-bold text-stone-100 font-mono">{stats.martial}</div>
          </div>
          <div className="p-1.5 bg-stone-900 border border-stone-800 rounded-lg" title="Stewardship: Domain Taxes & County Development">
            <div className="text-[11px]">💰</div>
            <div className="text-[9px] text-stone-400 font-sans">STE</div>
            <div className="text-xs font-bold text-stone-100 font-mono">{stats.stewardship}</div>
          </div>
          <div className="p-1.5 bg-stone-900 border border-stone-800 rounded-lg" title="Intrigue: Assassinations, Blackmail & Secrets">
            <div className="text-[11px]">🗡️</div>
            <div className="text-[9px] text-stone-400 font-sans">INT</div>
            <div className="text-xs font-bold text-stone-100 font-mono">{stats.intrigue}</div>
          </div>
          <div className="p-1.5 bg-stone-900 border border-stone-800 rounded-lg" title="Learning: Pious Dogma, Research & Medicine">
            <div className="text-[11px]">📜</div>
            <div className="text-[9px] text-stone-400 font-sans">LRN</div>
            <div className="text-xs font-bold text-stone-100 font-mono">{stats.learning}</div>
          </div>
        </div>
      </div>

      <div className="p-2.5 bg-stone-900/90 border border-stone-800 rounded-xl space-y-2">
        <div className="flex items-center justify-between text-[11px]">
          <span className="flex items-center gap-1 font-semibold text-stone-300">
            <Zap className="w-3.5 h-3.5 text-amber-400" />
            <span>Stress: {char.stress}/300</span>
          </span>
          <span className="text-[10px] font-medium text-amber-300">
            {char.stressCopingMechanism ? `Coping: ${char.stressCopingMechanism}` : char.stress > 85 ? 'Strained' : 'Serene'}
          </span>
        </div>
        <div className="w-full bg-stone-950 h-1.5 rounded-full overflow-hidden">
          <div
            className={`h-full rounded-full transition-all ${
              char.stress > 180 ? 'bg-red-500' : char.stress > 85 ? 'bg-amber-500' : 'bg-emerald-500'
            }`}
            style={{ width: `${Math.min(100, (char.stress / 300) * 100)}%` }}
          />
        </div>

        <div className="grid grid-cols-3 gap-1 pt-1 text-center text-[10px]">
          <div className="p-1 bg-stone-950/60 rounded border border-stone-800" title="Prestige: Fame in tournaments and feasts">
            <span className="text-stone-400">👑 Fame:</span> <span className="font-bold text-amber-200">{char.prestige}</span>
          </div>
          <div className="p-1 bg-stone-950/60 rounded border border-stone-800" title="Piety: Devotion to the holy priesthood">
            <span className="text-stone-400">☀️ Piety:</span> <span className="font-bold text-amber-200">{char.piety}</span>
          </div>
          <div className="p-1 bg-stone-950/60 rounded border border-stone-800" title="Dread: Fear and submission inspired in vassals">
            <span className="text-stone-400">💀 Dread:</span> <span className="font-bold text-red-300">{stats.dread}/100</span>
          </div>
        </div>
      </div>

      <div className="space-y-2">
        <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider">
          Active Trait Spectrum ({[...(char.personalityTraits || []), char.educationTrait, ...(char.congenitalTraits || []), ...(char.physicalHealthTraits || []), ...(char.commanderTraits || []), ...(char.lifestyleTraits || []), char.statusTrait].filter(Boolean).length})
        </div>
        <div className="flex flex-wrap gap-1.5">
          {char.educationTrait && (
            <span
              title="Education Trait (Tier 1-4)"
              className="px-2 py-0.5 bg-indigo-950/80 border border-indigo-600/70 rounded-md text-[10px] text-indigo-200 font-semibold flex items-center gap-1 cursor-help"
            >
              <span>🎓</span>
              <span>{char.educationTrait}</span>
            </span>
          )}

          {char.personalityTraits.map((tName) => {
            const traitDef = CK3_TRAITS.find((x) => x.name.toLowerCase() === tName.toLowerCase());
            return (
              <span
                key={tName}
                title={traitDef?.description}
                className="px-2 py-0.5 bg-stone-900 border border-stone-700/80 rounded-md text-[10px] text-amber-200 font-medium cursor-help"
              >
                {tName}
              </span>
            );
          })}

          {char.congenitalTraits.map((tName) => (
            <span
              key={tName}
              title="Congenital / Genetic Trait"
              className="px-2 py-0.5 bg-emerald-950/80 border border-emerald-600/70 rounded-md text-[10px] text-emerald-200 font-semibold flex items-center gap-1 cursor-help"
            >
              <span>🧬</span>
              <span>{tName}</span>
            </span>
          ))}

          {char.physicalHealthTraits.map((tName) => (
            <span
              key={tName}
              title="Health / Physical Condition"
              className="px-2 py-0.5 bg-rose-950/80 border border-rose-600/70 rounded-md text-[10px] text-rose-200 font-medium flex items-center gap-1 cursor-help"
            >
              <span>❤️‍🩹</span>
              <span>{tName}</span>
            </span>
          ))}

          {char.commanderTraits.map((tName) => (
            <span
              key={tName}
              title="Commander Warfare Specialization"
              className="px-2 py-0.5 bg-amber-950/80 border border-amber-600/70 rounded-md text-[10px] text-amber-200 font-medium flex items-center gap-1 cursor-help"
            >
              <span>⚔️</span>
              <span>{tName}</span>
            </span>
          ))}

          {char.lifestyleTraits.map((tName) => (
            <span
              key={tName}
              title="Lifestyle / Fame & Infamy"
              className="px-2 py-0.5 bg-purple-950/80 border border-purple-600/70 rounded-md text-[10px] text-purple-200 font-medium flex items-center gap-1 cursor-help"
            >
              <span>✨</span>
              <span>{tName}</span>
            </span>
          ))}

          {char.statusTrait && (
            <span
              title="Court & Dynastic Status"
              className="px-2 py-0.5 bg-blue-950/80 border border-blue-600/70 rounded-md text-[10px] text-blue-200 font-semibold flex items-center gap-1 cursor-help"
            >
              <span>👑</span>
              <span>{char.statusTrait}</span>
            </span>
          )}
        </div>
      </div>

      {(spouse || heir || rival || lover) && (
        <div className="space-y-1.5 pt-1">
          <div className="text-[10px] uppercase font-bold text-stone-400 tracking-wider">
            Court & Dynastic Ties
          </div>
          <div className="grid grid-cols-2 gap-1.5">
            {spouse && (
              <button
                onClick={() => onSelectCharacter(spouse)}
                className="p-2 bg-stone-900/90 border border-stone-800 hover:border-amber-600/50 rounded-lg text-left transition-colors cursor-pointer"
              >
                <div className="text-[9px] text-pink-400 font-semibold flex items-center gap-1">
                  <Heart className="w-2.5 h-2.5" />
                  <span>Spouse</span>
                </div>
                <div className="text-xs font-medium text-stone-200 truncate mt-0.5">{spouse.name}</div>
              </button>
            )}
            {heir && (
              <button
                onClick={() => onSelectCharacter(heir)}
                className="p-2 bg-stone-900/90 border border-stone-800 hover:border-amber-600/50 rounded-lg text-left transition-colors cursor-pointer"
              >
                <div className="text-[9px] text-amber-400 font-semibold flex items-center gap-1">
                  <Crown className="w-2.5 h-2.5" />
                  <span>Primary Heir</span>
                </div>
                <div className="text-xs font-medium text-stone-200 truncate mt-0.5">{heir.name}</div>
              </button>
            )}
            {rival && (
              <button
                onClick={() => onSelectCharacter(rival)}
                className="p-2 bg-stone-900/90 border border-stone-800 hover:border-red-600/50 rounded-lg text-left transition-colors cursor-pointer"
              >
                <div className="text-[9px] text-red-400 font-semibold flex items-center gap-1">
                  <Skull className="w-2.5 h-2.5" />
                  <span>Arch-Rival</span>
                </div>
                <div className="text-xs font-medium text-stone-200 truncate mt-0.5">{rival.name}</div>
              </button>
            )}
            {lover && (
              <button
                onClick={() => onSelectCharacter(lover)}
                className="p-2 bg-stone-900/90 border border-stone-800 hover:border-pink-600/50 rounded-lg text-left transition-colors cursor-pointer"
              >
                <div className="text-[9px] text-pink-300 font-semibold flex items-center gap-1">
                  <Heart className="w-2.5 h-2.5" />
                  <span>Secret Lover</span>
                </div>
                <div className="text-xs font-medium text-stone-200 truncate mt-0.5">{lover.name}</div>
              </button>
            )}
          </div>
        </div>
      )}

      {opinionEntries.length > 0 && (
        <div className="p-2.5 bg-stone-900/70 border border-stone-800 rounded-xl space-y-1.5">
          <button
            onClick={() => setShowOpinions(!showOpinions)}
            className="w-full flex items-center justify-between text-[10px] uppercase font-bold text-stone-400 tracking-wider cursor-pointer"
          >
            <span>Interpersonal Opinions ({opinionEntries.length})</span>
            {showOpinions ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
          </button>

          {showOpinions && (
            <div className="space-y-1 pt-1">
              {opinionEntries.map((op) => (
                <div key={op.targetId} className="flex items-center justify-between text-[11px] py-0.5">
                  <span className="text-stone-300 truncate">{op.name} ({op.role})</span>
                  <span className={`font-mono font-bold ${op.score > 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                    {op.score > 0 ? `+${op.score}` : op.score}
                  </span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      <div className="space-y-2 pt-1">
        <div className="p-2.5 bg-stone-900/90 border border-stone-800 rounded-lg space-y-1">
          <div className="text-[10px] uppercase font-bold text-amber-500 tracking-wider">
            Core Ambition
          </div>
          <p className="text-stone-300 font-serif leading-snug">{char.ambition}</p>
        </div>

        <div className="p-2.5 bg-stone-900/90 border border-stone-800 rounded-lg space-y-1">
          <div className="text-[10px] uppercase font-bold text-purple-400 tracking-wider flex items-center gap-1">
            <Eye className="w-3 h-3" />
            <span>Dark Secret</span>
          </div>
          <p className="text-stone-300 font-serif leading-snug">{char.darkSecret}</p>
        </div>

        {char.hooksHeld.length > 0 && (
          <div className="p-2.5 bg-amber-950/40 border border-amber-800/60 rounded-lg space-y-1">
            <div className="text-[10px] uppercase font-bold text-amber-400 tracking-wider flex items-center gap-1">
              <Key className="w-3 h-3" />
              <span>Blackmail Hooks Held</span>
            </div>
            {char.hooksHeld.map((h, i) => (
              <p key={i} className="text-stone-300 font-serif leading-snug text-[11px]">
                <strong className="text-amber-200">{h.type} Hook</strong> over {h.targetName}: {h.reason}
              </p>
            ))}
          </div>
        )}
      </div>

      {char.activeScheme && (
        <div className="p-3 bg-red-950/40 border border-red-900/60 rounded-xl space-y-2">
          <div className="flex items-center justify-between text-red-300 font-semibold text-[11px]">
            <span className="flex items-center gap-1.5">
              <Skull className="w-3.5 h-3.5 text-red-400" />
              <span>Conspiracy: {char.activeScheme.type}</span>
            </span>
            <span className="font-mono text-[10px] text-red-400 font-bold">
              {char.activeScheme.progress}% Progress
            </span>
          </div>
          <div className="w-full bg-stone-900 h-1.5 rounded-full overflow-hidden">
            <div
              className="bg-gradient-to-r from-red-600 to-amber-500 h-full rounded-full transition-all"
              style={{ width: `${char.activeScheme.progress}%` }}
            />
          </div>
          <div className="text-stone-300 text-[11px] pt-0.5">
            Target: <span className="font-medium text-stone-100">{char.activeScheme.targetName}</span>
          </div>
          <div className="text-[10px] text-stone-400 italic">
            "{char.activeScheme.motive}"
          </div>

          <button
            onClick={onExecuteScheme}
            className="w-full py-1.5 bg-red-800 hover:bg-red-700 text-white rounded-lg text-[11px] font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
          >
            <Skull className="w-3 h-3" />
            <span>Attempt Scheme Execution Now</span>
          </button>
        </div>
      )}

      {onWeaveStoryForCharacter && (
        <button
          onClick={() => onWeaveStoryForCharacter(char)}
          className="w-full py-2.5 bg-stone-800 hover:bg-stone-700 text-stone-200 border border-stone-700 rounded-xl text-xs font-medium flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-sm"
        >
          <Feather className="w-3.5 h-3.5 text-amber-400" />
          <span>Weave Saga with {char.name.split(' ')[0]}</span>
        </button>
      )}
    </div>
  );
};

interface CharacterListItemProps {
  char: Character;
  isSelected: boolean;
  onSelect: () => void;
}

const CharacterListItem: React.FC<CharacterListItemProps> = ({ char, isSelected, onSelect }) => {
  return (
    <div
      onClick={onSelect}
      className={`p-2.5 rounded-xl border transition-all cursor-pointer flex items-center justify-between gap-2.5 ${
        isSelected
          ? 'bg-amber-950/60 border-amber-600/80 shadow-md'
          : 'bg-stone-950/60 border-stone-800 hover:border-amber-600/40 hover:bg-stone-900/60'
      }`}
    >
      <div className="flex items-center gap-2.5 min-w-0">
        <span
          className="w-8 h-8 rounded-lg flex items-center justify-center text-base border border-stone-700 shrink-0 shadow-sm"
          style={{ backgroundColor: char.coatOfArms.bg, color: char.coatOfArms.fg }}
        >
          {char.coatOfArms.symbol}
        </span>
        <div className="min-w-0">
          <div className="font-serif font-bold text-stone-100 text-xs truncate">
            {char.name}
          </div>
          <div className="text-[10px] text-amber-400 truncate">
            {char.role} · <span className="text-stone-400">{char.aiArchetype}</span>
          </div>
        </div>
      </div>

      <div className="flex flex-col items-end shrink-0 text-[10px]">
        <span className="text-stone-400 font-mono">Age {char.age}</span>
        {char.activeScheme && (
          <span className="text-red-400 font-bold flex items-center gap-0.5">
            <Skull className="w-2.5 h-2.5" />
            <span>Scheme</span>
          </span>
        )}
      </div>
    </div>
  );
};

const CharacterPortraitNode = ({ char, isPrimary, onClick }: { char: Character, isPrimary?: boolean, onClick: () => void }) => {
  return (
    <div onClick={onClick} className="flex flex-col items-center gap-1 cursor-pointer group">
      <div 
        className={`w-12 h-12 rounded-full flex items-center justify-center text-xl shadow-lg border-2 transition-all ${isPrimary ? 'border-amber-400 ring-2 ring-amber-500/20' : 'border-stone-600 group-hover:border-amber-500'}`}
        style={{ backgroundColor: char.coatOfArms.bg, color: char.coatOfArms.fg }}
      >
        {char.coatOfArms.symbol}
      </div>
      <div className="text-[10px] font-bold text-stone-200 group-hover:text-amber-300 text-center max-w-[70px] leading-tight">
        {char.name.split(' ')[0]}
      </div>
      <div className="text-[9px] text-stone-500 text-center">{char.role}</div>
    </div>
  )
}
