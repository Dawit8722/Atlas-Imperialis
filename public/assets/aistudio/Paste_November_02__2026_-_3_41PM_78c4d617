import React, { useState, useMemo } from 'react';
import { Realm, Character, Burg, County, WorldState, HistoricalEvent } from '../types/world';
import {
  BookOpen,
  Feather,
  Skull,
  Eye,
  Heart,
  Shield,
  Crown,
  Flame,
  Key,
  Award,
  Sparkles,
  Zap,
  Swords,
  Search,
  Users,
  Compass,
  Lock,
  ChevronDown,
  ChevronUp,
  Coins,
  Navigation,
  Anchor,
  Scale,
} from 'lucide-react';
import { CK3_TRAITS, computeCharacterStats } from '../engine/fantasyTables';
import { CK3EventModal } from './CK3EventModal';
import { V17GrandStrategyPanels } from './V17GrandStrategyPanels';
import { computeTotalGravitas } from '../engine/v17GrandStrategyEngine';
import { motion } from 'motion/react';

interface CourtDossierProps {
  world: WorldState;
  selectedRealm?: Realm;
  selectedBurg?: Burg;
  selectedCounty?: County;
  onSelectCharacter: (char: Character) => void;
  onSelectRealm: (realm: Realm) => void;
  onSelectBurg: (burg: Burg) => void;
  onSelectCounty?: (county: County) => void;
  onOpenCompendiumForEntity: (entityId: string) => void;
  onWeaveStoryForCharacter?: (char: Character) => void;
  onUpdateWorld?: (newWorld: WorldState) => void;
}

export const CourtDossier: React.FC<CourtDossierProps> = ({
  world,
  selectedRealm,
  selectedBurg,
  selectedCounty,
  onSelectCharacter,
  onSelectRealm,
  onSelectBurg,
  onSelectCounty,
  onOpenCompendiumForEntity,
  onWeaveStoryForCharacter,
  onUpdateWorld,
}) => {
  const [activeTab, setActiveTab] = useState<
    | 'dynasty'
    | 'council'
    | 'dignitaries'
    | 'vassals'
    | 'travel'
    | 'claims'
    | 'feuds'
    | 'plague'
    | 'laws'
    | 'commerce'
    | 'prisoners'
    | 'roster'
    | 'citadel'
    | 'county'
  >('dynasty');
  const [inspectedCharId, setInspectedCharId] = useState<string | null>(null);
  const [searchQuery, setSearchQuery] = useState('');
  const [isEventModalOpen, setIsEventModalOpen] = useState(false);
  const [notificationMsg, setNotificationMsg] = useState<string | null>(null);

  const [isRealmPickerOpen, setIsRealmPickerOpen] = useState(false);
  const [isCountyPickerOpen, setIsCountyPickerOpen] = useState(false);
  const [isBurgPickerOpen, setIsBurgPickerOpen] = useState(false);

  const realm = selectedRealm || world.realms[0];
  const ruler = world.characters.find((c) => c.id === realm?.rulerId) || world.characters[0];
  const capital = world.burgs.find((b) => b.id === realm?.capitalBurgId);
  const burg = selectedBurg || capital;
  const county = selectedCounty || (burg ? world.counties.find((c) => c.id === burg.countyId) : undefined);
  const countyRuler = county ? world.characters.find((c) => c.id === county.rulerId) : undefined;

  const realmRoutes = useMemo(() => {
    if (!world.tradeNetwork || !realm) return [];
    const realmBurgIds = new Set(world.burgs.filter((b) => b.stateId === realm.id).map((b) => b.id));
    return world.tradeNetwork.routes.filter(
      (r) => realmBurgIds.has(r.fromBurgId) || realmBurgIds.has(r.toBurgId)
    );
  }, [world.tradeNetwork, realm, world.burgs]);

  const realmCaravans = useMemo(() => {
    if (!world.tradeNetwork || !realm) return [];
    const routeIds = new Set(realmRoutes.map((r) => r.id));
    return world.tradeNetwork.caravans.filter((c) => routeIds.has(c.routeId));
  }, [world.tradeNetwork, realmRoutes]);

  const burgConnectedRoutes = useMemo(() => {
    if (!world.tradeNetwork || !burg) return [];
    return world.tradeNetwork.routes.filter(
      (r) => r.fromBurgId === burg.id || r.toBurgId === burg.id
    );
  }, [world.tradeNetwork, burg]);

  const realmChars = useMemo(() => world.characters.filter((c) => c.realmId === realm?.id), [world.characters, realm]);
  const activeChar = useMemo(() => {
    if (inspectedCharId) {
      return world.characters.find((c) => c.id === inspectedCharId) || ruler;
    }
    return ruler;
  }, [inspectedCharId, world.characters, ruler]);

  const spouse = activeChar?.spouseId ? world.characters.find((c) => c.id === activeChar.spouseId) : undefined;
  const heir = activeChar?.heirId ? world.characters.find((c) => c.id === activeChar.heirId) : undefined;
  const rival = activeChar?.rivalId ? world.characters.find((c) => c.id === activeChar.rivalId) : undefined;
  const lover = activeChar?.loverId ? world.characters.find((c) => c.id === activeChar.loverId) : undefined;

  const dynastyMembers = useMemo(() => realmChars.filter((c) =>
    ['Monarch', 'Consort', 'Crown Heir', 'Cadet Prince', 'Cadet Princess', 'Legitimated Bastard', 'Disinherited Bastard', 'Dowager Regent', 'Royal Uncle'].includes(c.role)
  ), [realmChars]);

  const councilMembers = useMemo(() => realmChars.filter((c) =>
    ['Chancellor', 'Marshal', 'Steward', 'Spymaster', 'Court Chaplain'].includes(c.role)
  ), [realmChars]);

  const dignitaries = useMemo(() => realmChars.filter((c) =>
    ['Court Champion', 'Court Physician', 'Court Antiquarian', 'Grand Equerry', 'Royal Cupbearer', 'High Inquisitor', 'Court Jester'].includes(c.role)
  ), [realmChars]);

  const vassals = useMemo(() => realmChars.filter((c) =>
    ['Vassal Duke', 'Vassal Count', 'Vassal Consort', 'Vassal Heir'].includes(c.role)
  ), [realmChars]);

  const prisoners = useMemo(() => realmChars.filter((c) =>
    ['Dungeon Prisoner', 'Exiled Claimant'].includes(c.role)
  ), [realmChars]);

  const filteredRoster = useMemo(() => {
    if (!searchQuery.trim()) return realmChars;
    const q = searchQuery.toLowerCase();
    return realmChars.filter(
      (c) =>
        c.name.toLowerCase().includes(q) ||
        c.title.toLowerCase().includes(q) ||
        c.role.toLowerCase().includes(q) ||
        c.personalityTraits.some((t) => t.toLowerCase().includes(q)) ||
        c.educationTrait?.toLowerCase().includes(q) ||
        c.aiArchetype.toLowerCase().includes(q)
    );
  }, [realmChars, searchQuery]);

  const handleApplyEventOutcome = (outcomeText: string, updatedWorld: WorldState) => {
    if (onUpdateWorld) {
      onUpdateWorld(updatedWorld);
    }
    setNotificationMsg(outcomeText);
    setTimeout(() => setNotificationMsg(null), 6000);
  };

  const handleExecuteScheme = (char: Character) => {
    if (!char.activeScheme || !onUpdateWorld) return;
    const updated = JSON.parse(JSON.stringify(world)) as WorldState;
    const actor = updated.characters.find((c) => c.id === char.id)!;
    const target = updated.characters.find((c) => c.id === char.activeScheme!.targetId);

    const schemeName = char.activeScheme.type;
    const success = Math.random() < 0.65;

    if (success && target) {
      if (schemeName === 'Murder') {
        target.isAlive = false;
        setNotificationMsg(`Assassination Succeeded! ${target.name} perished from poisoned wine.`);
      } else {
        setNotificationMsg(`Conspiracy Succeeded! ${schemeName} against ${target.name} has borne fruit.`);
      }
      actor.prestige += 150;
      actor.dread = Math.min(100, actor.dread + 20);
      actor.activeScheme = undefined;
    } else {
      setNotificationMsg(`Conspiracy Foiled! Spymasters intercepted the plot by ${char.name}.`);
      actor.stress += 50;
      actor.activeScheme = undefined;
    }

    onUpdateWorld(updated);
  };

  if (!realm || !ruler) return null;

  const loreEntity = world.loreEntities.find((e) => e.stateId === realm.id || e.burgId === burg?.id);

  return (
    <motion.aside
      initial={{ x: '100%' }}
      animate={{ x: 0 }}
      exit={{ x: '100%' }}
      transition={{ type: 'spring', stiffness: 300, damping: 30 }}
      className="fixed right-4 top-20 bottom-24 w-96 flex flex-col bg-stone-900/60 backdrop-blur-2xl border border-white/10 rounded-2xl text-stone-200 overflow-hidden shadow-2xl select-text z-30"
    >
      {/* Realm Header */}
      <div className="p-4 border-b border-white/5 bg-black/20">
        <div className="flex items-center justify-between gap-3">
          <div className="flex items-center gap-2.5 min-w-0">
            <span
              className="w-10 h-10 rounded-xl flex items-center justify-center text-2xl shadow-md border border-stone-700 shrink-0"
              style={{ backgroundColor: realm.heraldry.bg, color: realm.heraldry.fg }}
            >
              {realm.heraldry.symbol}
            </span>
            <div className="min-w-0">
              <h2 className="font-cinzel font-bold text-base text-amber-100 leading-tight truncate">
                {realm.name}
              </h2>
              <div className="text-[11px] text-stone-400 mt-0.5 truncate">
                <span>{realm.culture}</span>
                <span className="mx-1 text-stone-600">·</span>
                <span>{realm.religion}</span>
                <span className="mx-1 text-stone-600">·</span>
                <span className="text-amber-500 font-medium">{realmChars.length} Court Nobles</span>
              </div>
            </div>
          </div>

          {loreEntity && (
            <button
              onClick={() => onOpenCompendiumForEntity(loreEntity.id)}
              title="Open Compendium Chapter"
              className="p-1.5 text-stone-400 hover:text-amber-400 hover:bg-stone-800 rounded-lg transition-colors cursor-pointer shrink-0"
            >
              <BookOpen className="w-4 h-4" />
            </button>
          )}
        </div>

        {/* Interactive Feudal Hierarchy Selector Strip */}
        <div className="mt-2.5 pt-2 border-t border-stone-800/80 space-y-1.5">
          <div className="text-[9px] font-bold uppercase tracking-wider text-stone-400 flex items-center justify-between">
            <span className="flex items-center gap-1">
              <Scale className="w-3 h-3 text-amber-500" />
              <span>Feudal Domain & Fief</span>
            </span>
            <span className="text-[9px] text-amber-400 font-normal">Select & Inspect</span>
          </div>

          <div className="grid grid-cols-3 gap-1 text-[10px]">
            {/* 1. Kingdom Picker Button */}
            <div className="relative">
              <button
                onClick={() => {
                  setIsRealmPickerOpen(!isRealmPickerOpen);
                  setIsCountyPickerOpen(false);
                  setIsBurgPickerOpen(false);
                }}
                className={`w-full p-1.5 rounded-lg border text-left flex items-center justify-between gap-1 transition-all cursor-pointer ${
                  isRealmPickerOpen
                    ? 'bg-amber-950 border-amber-600 text-amber-200'
                    : 'bg-stone-900/50 border-stone-800 hover:border-amber-700/60 text-stone-200'
                }`}
              >
                <div className="truncate flex items-center gap-1">
                  <span className="shrink-0">👑</span>
                  <span className="truncate font-serif font-semibold">{realm.name.replace('Kingdom of ', '')}</span>
                </div>
                <ChevronDown className="w-2.5 h-2.5 shrink-0 text-stone-400" />
              </button>

              {isRealmPickerOpen && (
                <div className="absolute top-full left-0 mt-1 w-64 bg-stone-950 border border-amber-600/70 rounded-xl shadow-2xl z-50 p-1.5 space-y-1 max-h-64 overflow-y-auto">
                  <div className="text-[9px] uppercase font-bold text-amber-400 px-2 py-1 border-b border-stone-800">
                    Kingdoms & Sovereign Realms ({world.realms.length})
                  </div>
                  {world.realms.map((r) => {
                    const isCur = r.id === realm.id;
                    const rRuler = world.characters.find((c) => c.id === r.rulerId);
                    return (
                      <div
                        key={r.id}
                        onClick={() => {
                          onSelectRealm(r);
                          const rBurg = world.burgs.find((b) => b.id === r.capitalBurgId) || world.burgs.find((b) => b.stateId === r.id);
                          if (rBurg) {
                            onSelectBurg(rBurg);
                            const ct = world.counties.find((c) => c.id === rBurg.countyId);
                            if (ct && onSelectCounty) onSelectCounty(ct);
                          }
                          setIsRealmPickerOpen(false);
                        }}
                        className={`p-2 rounded-lg cursor-pointer flex items-center justify-between text-xs transition-colors ${
                          isCur ? 'bg-amber-900/60 text-amber-200 font-bold border border-amber-700/50' : 'hover:bg-stone-800 text-stone-300'
                        }`}
                      >
                        <div className="flex items-center gap-2 truncate">
                          <span
                            className="w-5 h-5 rounded flex items-center justify-center text-xs shrink-0"
                            style={{ backgroundColor: r.heraldry.bg, color: r.heraldry.fg }}
                          >
                            {r.heraldry.symbol}
                          </span>
                          <div className="truncate">
                            <div className="truncate font-medium">{r.name}</div>
                            <div className="text-[9px] text-stone-400">{r.culture} · {rRuler?.name || 'Monarch'}</div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* 2. County / Duchy Picker Button */}
            <div className="relative">
              <button
                onClick={() => {
                  setIsCountyPickerOpen(!isCountyPickerOpen);
                  setIsRealmPickerOpen(false);
                  setIsBurgPickerOpen(false);
                }}
                className={`w-full p-1.5 rounded-lg border text-left flex items-center justify-between gap-1 transition-all cursor-pointer ${
                  isCountyPickerOpen
                    ? 'bg-amber-950 border-amber-600 text-amber-200'
                    : 'bg-stone-900/50 border-stone-800 hover:border-amber-700/60 text-stone-200'
                }`}
              >
                <div className="truncate flex items-center gap-1.5 min-w-0">
                  <span className="shrink-0">🛡️</span>
                  <div className="truncate min-w-0 text-left">
                    <span className="truncate font-serif font-semibold block leading-tight">{county?.name || 'County'}</span>
                  </div>
                </div>
                <ChevronDown className="w-2.5 h-2.5 shrink-0 text-stone-400 ml-0.5" />
              </button>

              {isCountyPickerOpen && (
                <div className="absolute top-full left-0 mt-1 w-64 bg-stone-950 border border-amber-600/70 rounded-xl shadow-2xl z-50 p-1.5 space-y-1 max-h-64 overflow-y-auto">
                  <div className="text-[9px] uppercase font-bold text-amber-400 px-2 py-1 border-b border-stone-800 flex items-center justify-between">
                    <span>Counties, Duchies & Marches</span>
                    <span>{world.counties.length} Total</span>
                  </div>
                  {world.counties.map((ct) => {
                    const isCur = ct.id === county?.id;
                    const ctRealm = world.realms.find((r) => r.id === ct.realmId);
                    const ctCap = world.burgs.find((b) => b.id === ct.capitalBurgId);
                    const ctLord = world.characters.find((c) => c.id === ct.rulerId);
                    return (
                      <div
                        key={ct.id}
                        onClick={() => {
                          if (onSelectCounty) onSelectCounty(ct);
                          if (ctRealm) onSelectRealm(ctRealm);
                          if (ctCap) onSelectBurg(ctCap);
                          setActiveTab('county');
                          setIsCountyPickerOpen(false);
                        }}
                        className={`p-2 rounded-lg cursor-pointer flex items-center justify-between text-xs transition-colors ${
                          isCur ? 'bg-amber-900/60 text-amber-200 font-bold border border-amber-700/50' : 'hover:bg-stone-800 text-stone-300'
                        }`}
                      >
                        <div className="truncate">
                          <div className="truncate font-serif font-medium">{ct.name}</div>
                          <div className="text-[9px] text-stone-400">
                            {ctLord ? <span className="text-amber-300 font-medium">Lord: {ctLord.title}</span> : `Caput: ${ctCap?.name}`}
                          </div>
                        </div>
                        <span className="text-[9px] px-1 py-0.5 rounded bg-stone-900 text-amber-400 font-mono shrink-0 ml-1">
                          {ctRealm?.name.split(' ')[0]}
                        </span>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* 3. Settlement / Burg Picker Button */}
            <div className="relative">
              <button
                onClick={() => {
                  setIsBurgPickerOpen(!isBurgPickerOpen);
                  setIsRealmPickerOpen(false);
                  setIsCountyPickerOpen(false);
                }}
                className={`w-full p-1.5 rounded-lg border text-left flex items-center justify-between gap-1 transition-all cursor-pointer ${
                  isBurgPickerOpen
                    ? 'bg-amber-950 border-amber-600 text-amber-200'
                    : 'bg-stone-900/50 border-stone-800 hover:border-amber-700/60 text-stone-200'
                }`}
              >
                <div className="truncate flex items-center gap-1">
                  <span className="shrink-0">{burg?.isCapital ? '👑' : burg?.type.includes('Port') ? '⚓' : '🏰'}</span>
                  <span className="truncate font-serif font-semibold">{burg?.name || 'Settlement'}</span>
                </div>
                <ChevronDown className="w-2.5 h-2.5 shrink-0 text-stone-400" />
              </button>

              {isBurgPickerOpen && (
                <div className="absolute top-full right-0 mt-1 w-68 bg-stone-950 border border-amber-600/70 rounded-xl shadow-2xl z-50 p-1.5 space-y-1 max-h-64 overflow-y-auto">
                  <div className="text-[9px] uppercase font-bold text-amber-400 px-2 py-1 border-b border-stone-800 flex items-center justify-between">
                    <span>Cities, Towns, Ports & Citadels</span>
                    <span>{world.burgs.length} Total</span>
                  </div>
                  {world.burgs.map((b) => {
                    const isCur = b.id === burg?.id;
                    const bRealm = world.realms.find((r) => r.id === b.stateId);
                    const bCounty = world.counties.find((c) => c.id === b.countyId);
                    const icon = b.isCapital ? '👑' : b.type.includes('Port') ? '⚓' : b.type.includes('Village') ? '🌾' : b.type.includes('Hamlet') ? '⛰️' : '🏰';
                    return (
                      <div
                        key={b.id}
                        onClick={() => {
                          onSelectBurg(b);
                          if (bRealm) onSelectRealm(bRealm);
                          if (bCounty && onSelectCounty) onSelectCounty(bCounty);
                          setActiveTab('citadel');
                          setIsBurgPickerOpen(false);
                        }}
                        className={`p-2 rounded-lg cursor-pointer flex items-center justify-between text-xs transition-colors ${
                          isCur ? 'bg-amber-900/60 text-amber-200 font-bold border border-amber-700/50' : 'hover:bg-stone-800 text-stone-300'
                        }`}
                      >
                        <div className="truncate flex items-center gap-2">
                          <span className="shrink-0">{icon}</span>
                          <div className="truncate">
                            <div className="truncate font-serif font-medium">{b.name}</div>
                            <div className="text-[9px] text-stone-400">
                              {b.type} · {b.population.toLocaleString()} souls
                            </div>
                          </div>
                        </div>
                        <span className="text-[9px] px-1 py-0.5 rounded bg-stone-900 text-stone-400 font-mono shrink-0">
                          {bRealm?.name.split(' ')[0]}
                        </span>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        </div>

        {/* Tab Selector with all CK3 Court Divisions & Fiefs */}
        <div className="flex items-center gap-1 mt-3 p-1 bg-stone-900/50 rounded-lg border border-white/5 text-[10px] overflow-x-auto">
          <button
            onClick={() => setActiveTab('dynasty')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'dynasty'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            Dynasty ({dynastyMembers.length})
          </button>
          <button
            onClick={() => setActiveTab('council')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'council'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            Council ({councilMembers.length})
          </button>
          <button
            onClick={() => setActiveTab('dignitaries')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'dignitaries'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            Dignitaries ({dignitaries.length})
          </button>
          <button
            onClick={() => setActiveTab('vassals')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'vassals'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            Vassals ({vassals.length})
          </button>
          <button
            onClick={() => setActiveTab('travel')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'travel'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            🧭 Travel
          </button>
          <button
            onClick={() => setActiveTab('claims')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'claims'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            ⚔️ Claims ({activeChar?.claims?.length || 0})
          </button>
          <button
            onClick={() => setActiveTab('feuds')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'feuds'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            🔥 Feuds ({Object.keys(world.cadetHouses || {}).length})
          </button>
          <button
            onClick={() => setActiveTab('plague')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'plague'
                ? 'bg-red-800 text-white font-semibold shadow-sm'
                : (world.epidemics?.length || 0) > 0 ? 'text-red-400 hover:text-red-300 font-bold' : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            ☠️ Plague ({world.epidemics?.length || 0})
          </button>
          <button
            onClick={() => setActiveTab('laws')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'laws'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            ⚖️ Laws
          </button>
          {prisoners.length > 0 && (
            <button
              onClick={() => setActiveTab('prisoners')}
              className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
                activeTab === 'prisoners'
                  ? 'bg-red-800 text-white font-semibold shadow-sm'
                  : 'text-red-400 hover:text-red-200'
              }`}
            >
              Captives ({prisoners.length})
            </button>
          )}
          <button
            onClick={() => setActiveTab('commerce')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'commerce'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            Commerce ({realmRoutes.length})
          </button>
          <button
            onClick={() => setActiveTab('roster')}
            className={`py-1 px-2 rounded text-center transition-colors cursor-pointer shrink-0 ${
              activeTab === 'roster'
                ? 'bg-amber-700 text-white font-semibold shadow-sm'
                : 'text-stone-400 hover:text-stone-200'
            }`}
          >
            All ({realmChars.length})
          </button>
          {county && (
            <button
              onClick={() => setActiveTab('county')}
