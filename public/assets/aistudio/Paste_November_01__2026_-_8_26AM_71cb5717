export class ClaimAndWarEngine {
  static fabricateClaim(c: Character, targetHolding: Holding, w: WorldState): boolean {
    const cost = 80;
    if ((c.treasury || 0) < cost) return false;
    c.treasury = (c.treasury || 0) - cost;

    if (!c.claims) c.claims = [];
    c.claims.push({
      holdingId: targetHolding.id,
      claimantId: c.id,
      isPressed: false,
      isStrong: false,
    });

    w.history.unshift({
      id: `hist_fab_claim_${c.id}_${targetHolding.id}_${Date.now() % 10000}`,
      year: w.currentYear,
      title: `Claim Fabricated: ${targetHolding.name}`,
      category: 'Dynastic Drama',
      description: `Through forged genealogical scrolls and secret bribes, ${c.name} manufactured a legal claim on ${targetHolding.name}!`,
      primaryActorId: c.id,
      realmId: c.realmId,
    });

    return true;
  }

  static declareClaimantWar(
    attacker: Character,
    claim: Claim,
    w: WorldState
  ): { won: boolean; summary: string } {
    const holding = w.holdings?.find((h) => h.id === claim.holdingId);
    if (!holding || !holding.ownerId) return { won: false, summary: 'Holding has no ruler.' };
    const defender = w.characters.find((c) => c.id === holding.ownerId);
    if (!defender || defender.id === attacker.id) return { won: false, summary: 'Invalid defender.' };

    const attackerProv = w.provinces?.find(p => p.id === attacker.provinceId);
    const defProv = w.provinces?.find((p) => p.id === holding.provinceId);
    if (!attackerProv || !defProv) return { won: false, summary: 'Location unknown.' };

    const attackerMil = (attacker.organicGravitas?.militaryAutonomy || 300) + (attacker.menAtArms || 50) * 3.0;
    const attackerTactics = getCharacterV17Stat(attacker, 'MARTIAL', w);
    const attackerPower = attackerMil * (1.0 + attackerTactics / 25.0) * (0.85 + Math.random() * 0.3);

    if (!w.armies) w.armies = [];
    const realm = w.realms.find(r => r.id === attacker.realmId);
    
    w.armies.push({
      id: `army_${Date.now()}`,
      attackerId: attacker.id,
      defenderId: defender.id,
      targetHoldingId: holding.id,
      startX: attackerProv.capitalX,
      startY: attackerProv.capitalY,
      targetX: defProv.capitalX,
      targetY: defProv.capitalY,
      progress: 0,
      strength: attackerPower,
      color: realm?.color || '#dc2626',
      claim: claim
    });

    const summary = `WAR DECLARED: ${attacker.name} has raised an army of ${Math.round(attackerPower)} men and is marching on ${holding.name}!`;
    return { won: true, summary };
  }

  static stepArmies(w: WorldState) {
    if (!w.armies) return;
    for (let i = w.armies.length - 1; i >= 0; i--) {
      const army = w.armies[i];
      army.progress += 0.05;

      if (army.progress >= 1.0) {
        const holding = w.holdings?.find(h => h.id === army.targetHoldingId);
        const attacker = w.characters.find(c => c.id === army.attackerId);
        const defender = w.characters.find(c => c.id === army.defenderId);
        
        if (holding && attacker && defender) {
          const defProv = w.provinces?.find(p => p.id === holding.provinceId);
          let terrainMult = defProv?.terrain === 'Mountains' ? 1.4 : defProv?.terrain === 'Forest' ? 1.2 : 1.0;
          const defenderTactics = getCharacterV17Stat(defender, 'MARTIAL', w);
          const defenderMil = ((defender.organicGravitas?.militaryAutonomy || 300) + (defender.menAtArms || 50) * 3.0) * terrainMult;
          const defenderPower = defenderMil * (1.0 + defenderTactics / 25.0) * (0.85 + Math.random() * 0.3);

          if (army.strength > defenderPower) {
            holding.ownerId = attacker.id;
            army.claim.isPressed = true;
            if (!defender.grudges) defender.grudges = [];
            defender.grudges.push({ reason: `Usurped ${holding.name}`, value: -100, months: 360 });

            w.history.unshift({
              id: `hist_war_win_${Date.now() % 10000}`,
              year: w.currentYear,
              title: `Siege of ${holding.name} Won`,
              category: 'War & Conquest',
              description: `${attacker.name}'s host shattered ${defender.name}'s garrisons! ${holding.name} was annexed.`,
              primaryActorId: attacker.id,
              secondaryActorId: defender.id,
              realmId: attacker.realmId,
            });
          } else {
            attacker.treasury = Math.max(0, (attacker.treasury || 0) - 120);
            defender.treasury = (defender.treasury || 0) + 120;
            attacker.stress = Math.min(300, (attacker.stress || 0) + 45);
            w.history.unshift({
              id: `hist_war_repulse_${Date.now() % 10000}`,
              year: w.currentYear,
              title: `Invasion of ${holding.name} Repulsed`,
              category: 'War & Conquest',
              description: `${defender.name} held the ramparts! ${attacker.name} was routed and paid 120g in indemnities.`,
              primaryActorId: defender.id,
              secondaryActorId: attacker.id,
              realmId: defender.realmId,
            });
          }
        }
        w.armies.splice(i, 1);
      }
    }
  }
}

