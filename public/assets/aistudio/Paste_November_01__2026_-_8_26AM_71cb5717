// 7. CADET HOUSES & DYNASTIC FEUDS
// ============================================

export class DynasticFeudEngine {
  static createCadetBranch(founder: Character, estate: Holding, w: WorldState): CadetHouse {
    if (!w.cadetHouses) w.cadetHouses = {};
    const cadetName = `${founder.houseName || 'House'}-${estate.name.split(' ')[0]}`;
    const cadet: CadetHouse = {
      name: cadetName,
      parentDynasty: founder.houseName || 'Ironcrown',
      founderId: founder.id,
      prestige: (founder.prestige || 100) * 0.8,
    };

    w.cadetHouses[cadetName] = cadet;
    founder.houseName = cadetName;

    w.history.unshift({
      id: `hist_cadet_${cadetName}_${Date.now() % 10000}`,
      year: w.currentYear,
      title: `Cadet Branch Founded: ${cadetName}`,
      category: 'Dynastic Drama',
      description: `${founder.name} has split from the parent dynasty to establish ${cadetName} with its own heraldic colors and seat at ${estate.name}!`,
      primaryActorId: founder.id,
      realmId: founder.realmId,
    });

    return cadet;
  }

  static declareFeud(houseAName: string, houseBName: string, reason: string, w: WorldState): void {
    if (!w.cadetHouses) w.cadetHouses = {};
    const houseA = w.cadetHouses[houseAName];
    if (houseA) {
      houseA.feudTargetDynasty = houseBName;
      houseA.feudReason = reason;
    }

    w.history.unshift({
      id: `hist_feud_${Date.now() % 10000}`,
      year: w.currentYear,
      title: `Blood Feud Sworn: ${houseAName} vs ${houseBName}`,
      category: 'Dynastic Drama',
      description: `House ${houseAName} has sworn an eternal Dynastic Vendetta against ${houseBName} over ${reason}! Daggers are drawn across all halls.`,
    });
  }
}

// ============================================
// 8. JUSTICE & COURT TRIALS
// ============================================

export class JusticeEngine {
  static accuse(
    accuser: Character,
    accused: Character,
    crime: CrimeType,
    w: WorldState
  ): { convicted: boolean; punishment?: PunishmentType; summary: string } {
    if (!accused.crimes) accused.crimes = [];
    accused.crimes.push({
      crimeType: crime,
      perpetratorId: accused.id,
      victimId: accuser.id,
      evidenceStrength: 0.85,
      monthRecorded: w.month || 0,
      discoveredById: accuser.id,
    });

    const judgeId = w.monarchId || w.characters[0]?.id;
    if (w.favors) {
      const debtIdx = w.favors.findIndex(
        (f) => f.creditorId === accused.id && f.debtorId === judgeId
      );
      if (debtIdx >= 0) {
        w.favors.splice(debtIdx, 1);
        const summary = `PARDON: ${accused.name} cashed in an ancient debt over the Crown, forcing all charges of ${crime} to be dismissed!`;
        w.history.unshift({
          id: `hist_pardon_${Date.now() % 10000}`,
          year: w.currentYear,
          title: `Royal Pardon: ${accused.name}`,
          category: 'Dynastic Drama',
          description: summary,
          primaryActorId: accused.id,
          realmId: accused.realmId,
        });
        return { convicted: false, summary };
      }
    }

    let gravitasShield = computeTotalGravitas(
      accused.organicGravitas || {
        militaryAutonomy: 300,
        economicExtraction: 100,
        populistLoyalty: 100,
        lineagePrestige: 100,
        sovereignDebtHeld: 0,
      }
    ) / 4000.0;
    if (w.realmLaws?.justice === 'Noble Immunity') gravitasShield *= 2.0;

    let odds = 0.7 - gravitasShield;
    if (w.realmLaws?.justice === 'Draconian') odds += 0.25;

    if (Math.random() < odds) {
      let punishment: PunishmentType = 'Dungeon';
      if (crime === 'Treason' || crime === 'Kingsblood' || crime === 'Murder') {
        punishment = 'Execution';
      } else if (crime === 'Heresy' || crime === 'Adultery') {
        punishment = 'Monastery';
      } else if (crime === 'Embezzlement' || crime === 'Tax Evasion') {
        punishment = 'Fine';
      } else if (crime === 'Refuse Levy' || crime === 'Plot Against Liege') {
        punishment = 'Revocation';
      }

      JusticeEngine.applySentence(accused, punishment, w);
      const summary = `CONVICTED: ${accused.name} was found guilty of ${crime} and sentenced to ${punishment}!`;

      w.history.unshift({
        id: `hist_conviction_${Date.now() % 10000}`,
        year: w.currentYear,
        title: `Royal Judgement: ${accused.name}`,
        category: 'Dynastic Drama',
        description: summary,
        primaryActorId: accused.id,
        realmId: accused.realmId,
      });

      return { convicted: true, punishment, summary };
    } else {
      const summary = `ACQUITTAL: ${accused.name} leveraged noble immunity and court influence to escape all charges of ${crime}.`;
      accused.paranoia = Math.min(100, (accused.paranoia || 10) + 20);

      w.history.unshift({
        id: `hist_acquit_${Date.now() % 10000}`,
        year: w.currentYear,
        title: `Trial Acquittal: ${accused.name}`,
        category: 'Dynastic Drama',
        description: summary,
        primaryActorId: accused.id,
        realmId: accused.realmId,
      });

      return { convicted: false, summary };
    }
  }

  static applySentence(accused: Character, p: PunishmentType, w: WorldState): void {
    if (p === 'Execution') {
      accused.isAlive = false;
    } else if (p === 'Mutilation') {
      const traits = accused.v17Traits || accused.personalityTraits || [];
      const injury = Math.random() < 0.5 ? 'Maimed' : 'Blinded';
      if (!traits.includes(injury)) traits.push(injury);
      accused.v17Traits = traits;
      accused.stress = Math.min(300, accused.stress + 60);
    } else if (p === 'Revocation') {
      if (w.holdings) {
        for (const h of w.holdings) {
          if (h.ownerId === accused.id) {
            h.ownerId = w.monarchId || accused.liegeId || '';
          }
        }
      }
    } else if (p === 'Banishment') {
      accused.isBanished = true;
      if (accused.courtPosition) accused.courtPosition.orbit = 'NONE';
      const traits = accused.v17Traits || accused.personalityTraits || [];
      if (!traits.includes('Exiled')) traits.push('Exiled');
      accused.v17Traits = traits;
    } else if (p === 'Dungeon') {
      accused.isImprisoned = true;
      if (accused.courtPosition) accused.courtPosition.orbit = 'NONE';
      const traits = accused.v17Traits || accused.personalityTraits || [];
      if (!traits.includes('Imprisoned')) traits.push('Imprisoned');
      accused.v17Traits = traits;
    } else if (p === 'Monastery') {
      accused.isMonk = true;
      if (accused.courtPosition) accused.courtPosition.orbit = 'NONE';
    } else if (p === 'Fine') {
      const fine = Math.min(accused.treasury || 100, 100);
      accused.treasury = Math.max(0, (accused.treasury || 0) - fine);
    }
  }
}

// ============================================
// 9. AUTONOMOUS AI BRAIN & FACTIONS
// ============================================

export class AutonomousAIBrain {
  static act(c: Character, w: WorldState): void {
    if (!c.isAlive || c.isMonk || c.id === w.monarchId) return;

    // 1. Self-Ransom from Dungeons
    if (c.isImprisoned) {
      if ((c.treasury || 0) >= 80) {
        const captorId = c.liegeId || w.monarchId;
        const captor = w.characters.find(x => x.id === captorId);
        if (captor && captor.id !== c.id) {
          c.treasury = (c.treasury || 0) - 80;
          captor.treasury = (captor.treasury || 0) + 80;
          c.isImprisoned = false;
          if (c.v17Traits) c.v17Traits = c.v17Traits.filter(t => t !== 'Imprisoned');
          w.history.unshift({
            id: `hist_ransom_${c.id}_${Date.now() % 10000}`,
            year: w.currentYear,
            title: `Ransom Paid: ${c.name}`,
            category: 'Dynastic Drama',
            description: `${c.name} paid an 80g ransom to ${captor.name} for freedom!`,
            primaryActorId: c.id,
            realmId: c.realmId,
          });
        }
      }
      return;
    }

    // 2. Emergency Bastard Legitimization
    const kids = (c.children || []).map(id => w.characters.find(k => k.id === id)).filter(Boolean) as Character[];
    const legitKids = kids.filter(k => !(k.v17Traits || []).includes('Bastard') && !k.isMonk && k.isAlive);
    if (legitKids.length === 0 && (c.age > 45)) {
      const bastards = kids.filter(k => (k.v17Traits || []).includes('Bastard') && k.isAlive);
      if (bastards.length > 0) {
        const chosen = bastards[0];
        chosen.v17Traits = (chosen.v17Traits || []).filter(t => t !== 'Bastard');
        chosen.v17Traits.push('Legitimized_Bastard');
        chosen.role = 'Crown Heir';
        c.stress = Math.min(300, c.stress + 15);
        w.history.unshift({
          id: `hist_legit_${chosen.id}_${Date.now() % 10000}`,
          year: w.currentYear,
          title: `Dynastic Legitimization: ${chosen.name}`,
          category: 'Dynastic Drama',
          description: `Facing extinction of their line, ${c.name} issued a royal decree legitimizing ${chosen.name} as heir!`,
          primaryActorId: c.id,
          secondaryActorId: chosen.id,
          realmId: c.realmId,
        });
      }
    }

    // 3. Proactive Guardianship & Fostering (Kids 6-16)
    for (const kidId of (c.children || [])) {
      const kid = w.characters.find(k => k.id === kidId);
      if (kid && kid.age >= 6 && kid.age < 16 && !kid.guardianId) {
        const potentialGuardians = w.characters.filter(x => x.age >= 25 && !x.isImprisoned && !x.isMonk && x.id !== kid.id);
        if (potentialGuardians.length > 0) {
          const mentor = potentialGuardians[Math.floor(Math.random() * potentialGuardians.length)];
          kid.guardianId = mentor.id;
        }
      }
    }

    // 4. Assassination Conspiracies
    const cTraits = c.v17Traits || c.personalityTraits || [];
    const intrigueStat = getCharacterV17Stat(c, 'INTRIGUE', w);
    if (intrigueStat >= 12 && (c.ambitionScore || 0) > 65 && Math.random() < 0.08) {
      const rivals = w.characters.filter(x => x.id !== c.id && x.isAlive && !x.isMonk && x.id !== c.trueLoveId && x.id !== c.spouseId);
      if (rivals.length > 0) {
        const target = rivals[Math.floor(Math.random() * rivals.length)];
        const isRoyal = target.id === w.monarchId;
        const crimeType: CrimeType = isRoyal ? 'Kingsblood' : 'Murder';

        const rollAtk = intrigueStat * (0.8 + Math.random() * 0.6);
        const rollDef = (getCharacterV17Stat(target, 'INTRIGUE', w) + 5) * (0.8 + Math.random() * 0.6);

        if (rollAtk > rollDef) {
          target.isAlive = false;
          w.history.unshift({
            id: `hist_assassin_${target.id}_${Date.now() % 10000}`,
            year: w.currentYear,
            title: `Assassination: ${target.name}`,
            category: 'Assassination',
            description: `Shadows strike in the dead of night! ${target.name} was assassinated in their bedchamber!`,
            secondaryActorId: target.id,
            realmId: target.realmId,
          });

          if (Math.random() < 0.40) {
            const monarch = w.characters.find(x => x.id === w.monarchId);
            if (monarch && monarch.id !== c.id) {
              JusticeEngine.accuse(monarch, c, crimeType, w);
            }
          }
          return;
        } else {
          const targetTraits = target.v17Traits || target.personalityTraits || [];
          if (!targetTraits.includes('Survived_Assassination')) {
            targetTraits.push('Survived_Assassination');
            target.v17Traits = targetTraits;
          }
          if (Math.random() < 0.60) {
            if (!target.grudges) target.grudges = [];
            target.grudges.push({ reason: 'Tried to Murder Me', value: -100, months: 600 });
            JusticeEngine.accuse(target, c, crimeType, w);
          }
        }
      }
    }

    // 5. Embezzlement by Greedy Councilors
    if (cTraits.includes('Greedy') && c.courtPosition?.orbit !== 'NONE' && Math.random() < 0.06) {
      const monarch = w.characters.find(x => x.id === w.monarchId);
      if (monarch) {
        const stolen = Math.min(monarch.treasury || 100, 60);
        monarch.treasury = (monarch.treasury || 100) - stolen;
        c.treasury = (c.treasury || 100) + stolen;
        if (Math.random() < 0.50) {
          JusticeEngine.accuse(monarch, c, 'Embezzlement', w);
        }
      }
    }

    // 6. Factions & Rebellion Coalitions
    if ((c.loyalty || 50) < 40 && (c.ambitionScore || 0) > 50 && Math.random() < 0.08) {
      if (!w.factions) w.factions = [];
      let faction = w.factions.find(f => f.members.includes(c.id) || f.leaderId === c.id);
      if (!faction) {
        faction = {
          id: `fact_${Date.now() % 10000}`,
          leaderId: c.id,
          name: 'The Liberty League',
          members: [c.id],
          ultimatumIssued: false,
        };
        w.factions.push(faction);
      } else if (faction.leaderId === c.id) {
        // Recruit discontented lords
        const potentialMembers = w.characters.filter(x => !faction!.members.includes(x.id) && x.id !== w.monarchId && (x.loyalty || 50) < 45);
        if (potentialMembers.length > 0) {
          faction.members.push(potentialMembers[0].id);
        }
      }

      // Check Ultimatum
      const factionLevies = faction.members.reduce((acc, mid) => {
        const noble = w.characters.find(x => x.id === mid);
        return acc + (noble?.organicGravitas?.militaryAutonomy || 200) + (noble?.menAtArms || 50) * 3;
      }, 0);

      const monarch = w.characters.find(x => x.id === w.monarchId);
      const crownLevies = (monarch?.organicGravitas?.militaryAutonomy || 300) + (monarch?.menAtArms || 100) * 3;

      if (factionLevies > crownLevies * 0.85 && !faction.ultimatumIssued) {
        faction.ultimatumIssued = true;
        w.history.unshift({
          id: `hist_ultimatum_${faction.id}`,
          year: w.currentYear,
          title: `Ultimatum: ${faction.name}`,
          category: 'Dynastic Drama',
          description: `The ${faction.name} coalition has massed its armies and issued an ultimatum to the Crown demanding autonomous liberties!`,
          realmId: c.realmId,
        });

        if (monarch && ((monarch.v17Traits || []).includes('Craven') || (w.hegemony || 1) < 0.75)) {
          // Monarch yields
          if (w.realmLaws) {
            w.realmLaws.authority = 'Autonomous';
          }
          w.factions = w.factions.filter(f => f.id !== faction!.id);
        } else {
          // Monarch refuses -> Civil War!
          w.realmState = 'Civil War';
        }
      }
    }
  }
}

// ============================================
// 10. CIVIL WAR & FOREIGN INVASIONS
// ============================================

export class CivilWarEngine {
  static resolve(w: WorldState): void {
    const monarch = w.characters.find(c => c.id === w.monarchId);
    const activeFaction = (w.factions || []).find(f => f.ultimatumIssued);
    if (!monarch || !activeFaction) {
      w.realmState = 'Balanced Feudalism';
      return;
    }

    const rebelMembers = activeFaction.members.map(mid => w.characters.find(c => c.id === mid)).filter(Boolean) as Character[];
    if (rebelMembers.length === 0) {
      w.factions = (w.factions || []).filter(f => f.id !== activeFaction.id);
      w.realmState = 'Balanced Feudalism';
      return;
    }

    const rebelLevies = rebelMembers.reduce((acc, m) => acc + (m.organicGravitas?.militaryAutonomy || 200) + (m.menAtArms || 50) * 3, 0);
    const monarchLevies = (monarch.organicGravitas?.militaryAutonomy || 300) + (monarch.menAtArms || 100) * 3;

    const rebelPower = rebelLevies * (0.8 + Math.random() * 0.4);
    const crownPower = monarchLevies * (0.8 + Math.random() * 0.4);

    if (rebelPower > crownPower) {
      // Rebels win!
      if (w.realmLaws) w.realmLaws.authority = 'Autonomous';
      w.realmState = 'Fragmentation';
      w.history.unshift({
        id: `hist_cw_win_${Date.now() % 10000}`,
        year: w.currentYear,
        title: `Civil War: The Crown Falls!`,
        category: 'War & Conquest',
        description: `The coalition shattered the royal host! Crown authority was broken down to Autonomous liberties.`,
        realmId: monarch.realmId,
      });
    } else {
      // Crown wins!
      w.realmState = 'Absolute Autocracy';
      for (const rebel of rebelMembers) {
        rebel.isImprisoned = true;
        if (!rebel.v17Traits) rebel.v17Traits = [];
        if (!rebel.v17Traits.includes('Imprisoned')) rebel.v17Traits.push('Imprisoned');
      }
      w.history.unshift({
        id: `hist_cw_crushed_${Date.now() % 10000}`,
        year: w.currentYear,
        title: `Civil War: Rebellion Crushed!`,
        category: 'War & Conquest',
        description: `The royal legions smashed the rebel coalition! All traitorous lords were cast into chains and dungeons.`,
        realmId: monarch.realmId,
      });
    }

    w.factions = (w.factions || []).filter(f => f.id !== activeFaction.id);
  }
}

export class ForeignInvasionEngine {
  static step(w: WorldState): void {
    const monarch = w.characters.find(c => c.id === w.monarchId);
    if (!monarch || !w.foreignNations) return;

    for (const nation of w.foreignNations) {
      if (nation.truceMonths > 0) {
        nation.truceMonths -= 1;
        continue;
      }

      if (Math.random() < (nation.threatLevel / 100.0) * 0.08) {
        w.realmState = 'Foreign Invasion';
        const realmLevies = w.characters.reduce((acc, c) => acc + (c.organicGravitas?.militaryAutonomy || 200) + (c.menAtArms || 50) * 3, 0);
        const invaderPower = nation.militaryStrength * (0.85 + Math.random() * 0.3);

        if (realmLevies >= invaderPower) {
          monarch.treasury = (monarch.treasury || 100) + 200;
          monarch.prestige = (monarch.prestige || 100) + 150;
          nation.truceMonths = 36;
          w.realmState = 'Balanced Feudalism';
          w.history.unshift({
            id: `hist_inv_win_${Date.now() % 10000}`,
            year: w.currentYear,
            title: `Invasion Repelled: ${nation.name}`,
            category: 'War & Conquest',
            description: `The banners of the united realm drove the ${nation.name} host into the sea! Plunder and glory were won.`,
            realmId: monarch.realmId,
          });
        } else {
          monarch.treasury = Math.max(0, (monarch.treasury || 100) - 200);
          monarch.stress = Math.min(300, monarch.stress + 45);
          nation.truceMonths = 36;
          w.realmState = 'Fragmentation';
          w.history.unshift({
            id: `hist_inv_defeat_${Date.now() % 10000}`,
            year: w.currentYear,
            title: `Devastation: ${nation.name} Invades!`,
            category: 'War & Conquest',
            description: `The ${nation.name} broke the border defenses, sacking border towns and forcing humiliating reparations.`,
            realmId: monarch.realmId,
          });
        }
      }
    }
  }
}

// ============================================
// 11. WORLD INITIALIZATION & MONTHLY STEP
// ============================================

export function ensureV17WorldInitialized(world: WorldState): WorldState {
  if (world.provinces && world.holdings && world.realmLaws) {
    return world;
  }

  const w = JSON.parse(JSON.stringify(world)) as WorldState;
  w.month = w.month || 1;
  w.hegemony = w.hegemony || 1.15;
  w.realmState = w.realmState || 'Balanced Feudalism';
  w.lockedDownProvinces = w.lockedDownProvinces || [];
  w.epidemics = w.epidemics || [];
  w.cadetHouses = w.cadetHouses || {};
  w.factions = w.factions || [];
  w.favors = w.favors || [];
  w.armies = w.armies || [];

  w.foreignNations = w.foreignNations || [
    { name: 'Valyrian Empire', militaryStrength: 1500, threatLevel: 25, truceMonths: 0 },
    { name: 'Iron Steppe Nomads', militaryStrength: 1000, threatLevel: 40, truceMonths: 0 },
  ];

  w.realmLaws = w.realmLaws || {
    succession: 'Partition',
    gender: 'Agnatic-Cognatic',
    authority: 'Limited',
    justice: 'Traditional',
  };

  const provinces: Province[] = [];
  const holdings: Holding[] = [];

  let provCounter = 1;
  for (const c of w.counties) {
    const countyCells = w.cells.filter((cell) => cell.countyId === c.id || c.cellIndices.includes(cell.index));
    const avgElev = countyCells.reduce((acc, cell) => acc + cell.elevation, 0) / (countyCells.length || 1);
    const hasCoast = countyCells.some((cell) => cell.isCoast);
    const hasForest = countyCells.some((cell) => cell.reliefType === 'forest');

    let terrain: TerrainType = 'Plains';
    if (avgElev > 0.65) terrain = 'Mountains';
    else if (hasCoast) terrain = 'Coastal';
    else if (hasForest) terrain = 'Forest';

    const capitalBurg = w.burgs.find((b) => b.id === c.capitalBurgId) || w.burgs[0];

    const prov: Province = {
      id: `prov_${provCounter++}`,
      name: c.name,
      realmId: c.realmId,
      terrain,
      neighbors: [],
      holdingIds: [],
      cellIndices: c.cellIndices,
      capitalX: capitalBurg ? capitalBurg.x : 500,
      capitalY: capitalBurg ? capitalBurg.y : 350,
      isQuarantined: false,
    };
    provinces.push(prov);
  }

  for (let i = 0; i < provinces.length; i++) {
    for (let j = i + 1; j < provinces.length; j++) {
      const p1 = provinces[i];
      const p2 = provinces[j];
      const dist = Math.hypot(p1.capitalX - p2.capitalX, p1.capitalY - p2.capitalY);
      if (dist < 320) {
        p1.neighbors.push(p2.id);
        p2.neighbors.push(p1.id);
      }
    }
  }

  let holdingCounter = 1;
  const estateTypes: EstateType[] = ['Castle', 'City', 'Temple'];
  for (let i = 0; i < provinces.length; i++) {
    const prov = provinces[i];
    const estateType = estateTypes[i % 3];
    const owner = w.characters[i % w.characters.length] || w.characters[0];

    const h: Holding = {
      id: `holding_${holdingCounter++}`,
      name: `${prov.name} ${estateType}`,
      estateType,
      provinceId: prov.id,
      baseTax: estateType === 'City' ? 35 : estateType === 'Temple' ? 18 : 12,
      baseLevy: estateType === 'Castle' ? 500 : estateType === 'City' ? 180 : 220,
      dev: 25 + (i % 15),
      adminOverhead: 10,
      ownerId: owner?.id || 'char_1',
    };
    holdings.push(h);
    prov.holdingIds.push(h.id);
  }

  w.provinces = provinces;
  w.holdings = holdings;

  const realm1 = w.realms[0];
  const capBurg = w.burgs.find((b) => b.id === realm1?.capitalBurgId);
  const capProv = provinces.find((p) => p.capitalX === capBurg?.x) || provinces[0];
  w.capitalProvinceId = capProv?.id || provinces[0]?.id;
  w.monarchId = realm1?.rulerId || w.characters[0]?.id;

  for (let idx = 0; idx < w.characters.length; idx++) {
    const char = w.characters[idx];
    const prov = provinces[idx % provinces.length];
    char.provinceId = prov.id;
    char.isTraveling = false;
    char.travelMonthsLeft = 0;
    char.travelPurpose = '';
    char.menAtArms = 50 + (idx % 4) * 25;
    char.treasury = 100 + (idx % 5) * 40;
    char.loyalty = 50 + (idx % 4) * 10;
    char.ambitionScore = 30 + (idx % 6) * 12;
    char.paranoia = 15 + (idx % 3) * 15;
    char.contentment = 60;
    char.psychState = 'Normal';
    char.vassalIds = [];
    char.crimes = [];
    char.grudges = [];

    const v17Traits: string[] = [];
    for (const t of char.personalityTraits) {
      if (V17_TRAIT_DB[t]) v17Traits.push(t);
    }
    if (char.congenitalTraits?.includes('Genius')) v17Traits.push('Genius');
    if (char.congenitalTraits?.includes('Beautiful')) v17Traits.push('Beautiful');
    if (char.congenitalTraits?.includes('Giant')) v17Traits.push('Giant');
    if (char.congenitalTraits?.includes('Robust')) v17Traits.push('Robust');
    if (v17Traits.length === 0) v17Traits.push('Just', 'Brave');
    char.v17Traits = v17Traits;

    const orbitRing: AccessLevel =
      char.id === w.monarchId
        ? 'INNER_RING'
        : idx < 4
        ? 'INNER_RING'
        : idx < 8
        ? 'MIDDLE_RING'
        : 'OUTER_RING';
    char.courtPosition = {
      orbit: orbitRing,
      capitalSecrets: 10 + (idx % 5) * 5,
      capitalBottlenecks: 15,
      capitalFavors: 10,
      decayPressure: 0,
    };

    char.organicGravitas = {
      militaryAutonomy: 250 + (idx % 5) * 80,
      economicExtraction: 40 + (idx % 4) * 15,
      populistLoyalty: 120 + (idx % 3) * 50,
      lineagePrestige: char.prestige || 100,
      sovereignDebtHeld: idx === 2 ? 100 : 0,
    };

    char.claims = [];
    if (idx === 1 && holdings[0]) {
      char.claims.push({
        holdingId: holdings[0].id,
        claimantId: char.id,
        isPressed: true,
        isStrong: true,
      });
    }
  }

  if (w.characters.length >= 2) {
    w.favors.push({
      id: `favor_init_1`,
      debtorId: w.monarchId || w.characters[0].id,
      creditorId: w.characters[1].id,
      value: 100,
      origin: 'Ancient Dynastic Blood Debt',
      isDynastyLevel: true,
      ageInYears: 12,
    });
  }

  return w;
}

export function advanceV17GrandStrategyStep(world: WorldState): WorldState {
  const w = ensureV17WorldInitialized(world);
  w.month = (w.month || 0) + 1;

  // 1. Geography & Spatial Travel
  GeographyAndTravelEngine.step(w);

  // 2. Plague & Quarantines
  PlagueEngine.step(w);

  // 3. Marching Armies & Sieges
  ClaimAndWarEngine.stepArmies(w);

  // 4. Lust, Dynasty & Pregnancies
  for (const c of w.characters) {
    if (c.isAlive) {
      LustAndDynastyEngine.process(c, w);
    }
  }

  // 5. Autonomous AI Brain (Assassinations, Embezzlement, Factions, Ransoms)
  for (const c of w.characters) {
    if (c.isAlive) {
      AutonomousAIBrain.act(c, w);
    }
  }

  // 6. Civil War Resolution
  if (w.realmState === 'Civil War') {
    CivilWarEngine.resolve(w);
  }

  // 7. Foreign Invasions
  ForeignInvasionEngine.step(w);

  // 8. Sovereign Hegemony Check
  const crownHoldings = (w.holdings || []).filter(h => h.ownerId === w.monarchId);
  const crownLevies = crownHoldings.reduce((acc, h) => acc + getHoldingYields(h).levy, 200);
  const nobleLevies = (w.holdings || [])
    .filter(h => h.ownerId !== w.monarchId)
    .reduce((acc, h) => acc + getHoldingYields(h).levy, 200);

  w.hegemony = crownLevies / Math.max(1, nobleLevies * 0.7);
  if (w.realmState !== 'Civil War' && w.realmState !== 'Foreign Invasion') {
    if (w.hegemony >= 1.5) w.realmState = 'Absolute Autocracy';
    else if (w.hegemony >= 0.75) w.realmState = 'Balanced Feudalism';
    else w.realmState = 'Fragmentation';
  }

  return w;
}
