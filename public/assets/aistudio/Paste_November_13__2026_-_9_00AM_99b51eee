                    data.sentiment === 'Struggling' ? 'text-orange-300 bg-orange-950/60 border-orange-700/60' :
                    'text-red-300 bg-red-950/80 border-red-700 font-bold animate-pulse';

                  return (
                    <div key={className} className="p-3 rounded-xl border border-stone-800 bg-stone-950/60 space-y-2">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="font-bold text-xs text-stone-200 flex items-center gap-1.5">
                            <span>{className === 'Peasants' ? '🌾' : className === 'Artisans' ? '⚒️' : className === 'Merchants' ? '⚖️' : className === 'Clergy' ? '⛪' : '👑'}</span>
                            <span>{className}</span>
                            <span className="text-[10px] text-stone-500 font-mono">({data.count.toLocaleString()} souls)</span>
                          </div>
                        </div>
                        <span className={`px-2 py-0.5 rounded text-[10px] font-mono border ${sentimentColor}`}>
                          {data.sentiment}
                        </span>
                      </div>

                      <div className="grid grid-cols-3 gap-2 text-[10px] font-mono pt-1 border-t border-stone-800/80">
                        <div className="p-1.5 rounded bg-black/40 border border-white/5">
                          <div className="text-stone-500">MONTHLY WAGE</div>
                          <div className="font-bold text-emerald-400 text-xs mt-0.5">+{data.averageIncome}g</div>
                        </div>
                        <div className="p-1.5 rounded bg-black/40 border border-white/5">
                          <div className="text-stone-500">LIVING BASKET</div>
                          <div className="font-bold text-rose-400 text-xs mt-0.5">-{data.livingCost}g</div>
                        </div>
                        <div className="p-1.5 rounded bg-black/40 border border-white/5">
                          <div className="text-stone-500">REAL SOL</div>
                          <div className={`font-bold text-xs mt-0.5 ${data.standardOfLiving >= 1.0 ? 'text-amber-300' : 'text-red-400'}`}>
                            {data.standardOfLiving.toFixed(2)}x
                          </div>
                        </div>
                      </div>

                      {data.unrest > 50 && (
                        <div className="p-1.5 rounded bg-red-950/40 border border-red-900/60 text-[10px] text-red-300 flex items-center gap-1.5">
                          <ShieldAlert className="w-3.5 h-3.5 text-red-400 shrink-0" />
                          <span>High Unrest ({data.unrest}%)! At risk of strikes or rioting.</span>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ) : (
            <div className="flex h-32 items-center justify-center rounded-xl border border-stone-800 border-dashed bg-stone-950/30 p-6 text-center text-sm text-stone-500">
              Select a settlement on the map to inspect its social classes, wages, and living standards.
            </div>
          )
        )}

      </div>
    </div>
  );
}

